# Copy to frontend/.env.local (git-ignored) and fill in. Next.js loads it automatically.
# Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.

# Where the Next.js server proxies /api/* to (next.config.mjs rewrites) and what /api/health checks.
# Local development: the default below works (and so does leaving it out).
# Production (`next build` / `next start`): required, must be the API's public https URL, e.g.
#   API_URL=https://your-api.vercel.app
# A production build fails when it is missing, malformed, plain http or points at localhost.
# For a deliberately local production build (CI, the browser tests, `pnpm build` on a laptop),
# add ALLOW_LOCAL_API=1 to skip those production rules.
API_URL=http://localhost:4000

# true = the Workforce screens use built-in mock data instead of the API.
NEXT_PUBLIC_WORKFORCE_MOCK=false
